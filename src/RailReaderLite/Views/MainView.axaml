<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RailReaderLite.ViewModels"
             xmlns:m="using:RailReader.Core.Models"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="RailReaderLite.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Toolbar -->
    <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" DockPanel.Dock="Left">
          <Button Content="Open PDF…"
                  Command="{Binding OpenCommand}"
                  CommandParameter="{Binding $parent[TopLevel].StorageProvider}" />
          <Button Content="◀"
                  Command="{Binding PrevCommand}"
                  IsEnabled="{Binding CanPrev}"
                  ToolTip.Tip="Previous page" />
          <Button Content="▶"
                  Command="{Binding NextCommand}"
                  IsEnabled="{Binding CanNext}"
                  ToolTip.Tip="Next page" />
          <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" MinWidth="60" />
          <Button Content="☰  Outline"
                  Command="{Binding ToggleOutlineCommand}"
                  IsVisible="{Binding HasOutline}"
                  ToolTip.Tip="Toggle outline panel" />
        </StackPanel>

        <!-- Search controls -->
        <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Right"
                    IsVisible="{Binding HasDocument}">
          <TextBlock Text="{Binding MatchStatus}" VerticalAlignment="Center" MinWidth="60"
                     Opacity="0.7" HorizontalAlignment="Right" />
          <Button Content="✕" Command="{Binding ClearSearchCommand}" ToolTip.Tip="Clear search"
                  IsVisible="{Binding MatchCount}" />
          <Button Content="↑" Command="{Binding PrevMatchCommand}" ToolTip.Tip="Previous match" />
          <Button Content="↓" Command="{Binding NextMatchCommand}" ToolTip.Tip="Next match (F3)" />
          <TextBox Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="Find…"
                   MinWidth="160"
                   VerticalAlignment="Center"
                   KeyDown="OnSearchBoxKeyDown" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Status bar (bottom). Surfaces StatusText — covers things like
         "Copied 42 characters." / "Failed to open: …" / file name on
         load. Was inadvertently dropped in 0.5.0 when the toolbar
         picked up search controls. -->
    <Border Grid.Row="2" Padding="12,6"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <TextBlock Text="{Binding StatusText}"
                 Opacity="0.85"
                 TextTrimming="CharacterEllipsis" />
    </Border>

    <!-- Main area: optional outline pane + page viewport -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
      <!-- Outline pane (left, collapsible) -->
      <Border Grid.Column="0"
              Width="260"
              IsVisible="{Binding OutlineVisible}"
              BorderThickness="0,0,1,0"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <TreeView ItemsSource="{Binding Outline}"
                  SelectedItem="{Binding SelectedOutlineEntry, Mode=TwoWay}"
                  Margin="4">
          <TreeView.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding Children}" DataType="m:OutlineEntry">
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Border>

      <!-- Page viewport -->
      <Border Grid.Column="1" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
        <Panel>
          <!-- Empty-state hint -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                      IsVisible="{Binding !HasDocument}">
            <TextBlock Text="RailReaderLite"
                       FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="Open a PDF to begin."
                       Opacity="0.6" HorizontalAlignment="Center" />
          </StackPanel>

          <!-- Rendered page. Pointer events handle drag-to-select; a
               Canvas sibling draws the live selection rect during drag. -->
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        IsVisible="{Binding HasDocument}">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
              <Image x:Name="PageImageView"
                     Source="{Binding PageImage}"
                     Stretch="Uniform"
                     StretchDirection="DownOnly"
                     Cursor="IBeam"
                     PointerPressed="OnPagePointerPressed"
                     PointerMoved="OnPagePointerMoved"
                     PointerReleased="OnPagePointerReleased" />
              <Canvas IsHitTestVisible="False" ClipToBounds="True">
                <Rectangle x:Name="SelectionRect"
                           Fill="#553B82F6"
                           Stroke="#FF3B82F6"
                           StrokeThickness="1"
                           IsVisible="False" />
              </Canvas>
            </Grid>
          </ScrollViewer>

          <!-- Busy indicator -->
          <Border IsVisible="{Binding IsBusy}"
                  Background="#A0000000"
                  CornerRadius="6"
                  Padding="16,10"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0">
            <TextBlock Text="Loading…" Foreground="White" />
          </Border>
        </Panel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
