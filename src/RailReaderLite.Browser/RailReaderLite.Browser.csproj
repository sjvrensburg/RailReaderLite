<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <!--
      Statically link native Skia/HarfBuzz archives into the WASM bundle.
      Avalonia.Browser uses SkiaSharp for all rendering (text included),
      so without this the first frame throws `System.DllNotFoundException:
      libSkiaSharp` from `SKImageInfo..cctor()`. Requires the wasm-tools
      workload (Emscripten).
    -->
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RailReaderLite\RailReaderLite.csproj" />
  </ItemGroup>
</Project>
