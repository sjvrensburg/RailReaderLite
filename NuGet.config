<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />

    <!--
      Local development override for RailReaderCore branches:
        1. cd ~/RailReaderCore && dotnet pack RailReaderCore.slnx -c Release -o /tmp/railreadercore-dist
        2. Uncomment the line below.
        3. Bump RailReader.Core version in Directory.Packages.props to match the local pack.
        4. dotnet restore.
      Don't commit the uncomment.
    -->
    <!-- <add key="local-railreadercore" value="/tmp/railreadercore-dist" /> -->
  </packageSources>
</configuration>
